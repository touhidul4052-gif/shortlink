# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base URL used to build short links (no trailing slash)
SHORT_BASE_URL=http://localhost:3000

# Redirect strategy: "301" (permanent, cacheable) or "302" (temporary, always re-hits server)
REDIRECT_STATUS=302

# Postgres
DATABASE_URL=postgres://shortlink:shortlink@127.0.0.1:5432/shortlink

# Slug generation
SHORT_CODE_MIN_LENGTH=6
SHORT_CODE_ID_OFFSET=1000
