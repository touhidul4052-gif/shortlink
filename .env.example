# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base URL used to build short links (no trailing slash)
SHORT_BASE_URL=http://localhost:3000

# Redirect strategy: "301" (permanent, cacheable) or "302" (temporary, always re-hits server)
REDIRECT_STATUS=302

# Postgres
# Note: docker-compose maps Postgres to host port 5433 (not 5432) to avoid
# clashing with a system-installed Postgres. Adjust if you run Postgres directly.
DATABASE_URL=postgres://shortlink:shortlink@127.0.0.1:5433/shortlink

# Slug generation
SHORT_CODE_MIN_LENGTH=6
SHORT_CODE_ID_OFFSET=1000
